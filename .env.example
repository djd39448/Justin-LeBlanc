# Copy outside the repository to a protected host config directory. Never commit populated values.
NODE_ENV=production
PORT=4318
PUBLIC_SITE_URL=https://justinleblancmusic.50by50.dev
API_URL=https://jlm-demo-api.50by50.dev
DEMO_MODE=true
DATABASE_URL=private/jlm-demo.sqlite
PRIVATE_STORAGE_PATH=private/documents
ADMIN_TOKEN=replace-with-at-least-32-random-characters
JOB_AUTH_SECRET=replace-with-another-32-random-characters
DEMO_RECIPIENT_ALLOWLIST=operator@example.com,client@example.com
OPERATOR_EMAIL=operator@example.com
PERFORMER_EMAIL=operator@example.com
CLIENT_TEST_EMAIL=client@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SHOW_CALENDAR_ID=
FREE_BUSY_CALENDAR_IDS=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_DAILY_TURN_LIMIT=100
# Set this outside the repo when a background user uses a shared Playwright installation.
PLAYWRIGHT_BROWSERS_PATH=
RETELL_API_KEY=
RETELL_JLM_AGENT_ID=
RETELL_JLM_PHONE_NUMBER=
DEMO_CALLER_ALLOWLIST=
