---
/**
 * Renders Justin's original photographs with responsive Astro image optimization.
 *
 * Dependencies: Local, source-preserved artist photographs.
 * Depended on by: Home and About pages.
 * Why this exists: Visitors should see the person and instruments behind the event inquiry.
 */
import { Image } from "astro:assets";
import playingGuitar from "../assets/justin-playing-guitar.png";
import portrait from "../assets/justin-portrait.png";
import { site } from "../content";

interface Props {
  id?: string;
  showLinks?: boolean;
  variant?: "pair" | "portrait";
}

const { id, showLinks = false, variant = "pair" } = Astro.props;
const isPair = variant === "pair";
const headingId = id ? `${id}-title` : `artist-photos-${variant}`;
---

<section
  id={id}
  class:list={[
    "artist-photos",
    { "artist-photos--portrait": !isPair, "artist-photos--social": showLinks }
  ]}
  aria-labelledby={headingId}
>
  <div class="page-shell">
    <header class="artist-photos__heading">
      <h2 id={headingId}>Meet Justin</h2>
    </header>

    <div class="artist-photos__grid">
      <div class="artist-photos__frame">
        <Image
          src={portrait}
          alt="Justin LeBlanc in a plaid shirt beside an upright guitar"
          widths={[480, 720, 960, 1200]}
          sizes={isPair ? "(min-width: 60rem) 38rem, calc(100vw - 2.5rem)" : "(min-width: 64rem) 64rem, calc(100vw - 2.5rem)"}
          layout="constrained"
          loading="lazy"
          decoding="async"
          format="webp"
        />
      </div>

      {isPair && (
        <div class="artist-photos__frame">
          <Image
            src={playingGuitar}
            alt="Justin LeBlanc smiling while playing a guitar"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 60rem) 38rem, calc(100vw - 2.5rem)"
            layout="constrained"
            loading="lazy"
            decoding="async"
            format="webp"
          />
        </div>
      )}
    </div>

    {showLinks && (
      <nav class="artist-photos__links" aria-label="Justin LeBlanc on social media">
        <a href={site.instagram} rel="external">Instagram</a>
        <a href={site.youtube} rel="external">YouTube</a>
        <a href={site.facebook} rel="external">Facebook</a>
        <a href={site.currentSite} rel="external">Current website</a>
      </nav>
    )}
  </div>
</section>

<style>
  .artist-photos {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background:
      linear-gradient(135deg, rgba(49, 93, 245, 0.08), transparent 44%),
      var(--paper);
  }

  .artist-photos--social {
    background:
      radial-gradient(circle at 85% 12%, rgba(49, 93, 245, 0.42), transparent 30rem),
      var(--navy-900);
    color: var(--paper-light);
  }

  .artist-photos__heading {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .artist-photos__heading h2 {
    margin-bottom: 0;
  }

  .artist-photos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .artist-photos--portrait .artist-photos__grid {
    grid-template-columns: minmax(0, 64rem);
  }

  .artist-photos__frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-light);
    box-shadow: var(--shadow);
  }

  .artist-photos__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  .artist-photos__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .artist-photos__links a {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 999px;
    color: var(--paper-light);
    font-weight: 700;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .artist-photos__links a:hover {
    border-color: var(--paper-light);
    background: var(--paper-light);
    color: var(--navy-900);
  }

  @media (max-width: 48rem) {
    .artist-photos__grid {
      grid-template-columns: 1fr;
    }

    .artist-photos__links a {
      flex: 1 1 9rem;
    }
  }
</style>
