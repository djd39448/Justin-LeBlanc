---
/**
 * Renders Justin's original photographs with responsive Astro image optimization.
 *
 * Dependencies: Local, source-preserved artist photographs.
 * Depended on by: Home and About pages.
 * Why this exists: Visitors should see the person and instruments behind the event inquiry.
 */
import { Image } from "astro:assets";
import playingGuitar from "../assets/justin-playing-guitar.png";
import portrait from "../assets/justin-portrait.png";

interface Props {
  variant?: "pair" | "portrait";
}

const { variant = "pair" } = Astro.props;
const isPair = variant === "pair";
const headingId = `artist-photos-${variant}`;
---

<section class:list={["artist-photos", { "artist-photos--portrait": !isPair }]} aria-labelledby={headingId}>
  <div class="page-shell">
    <header class="artist-photos__heading">
      <p class="eyebrow">Meet Justin</p>
      <h2 id={headingId}>{isPair ? "With a guitar in hand." : "The person behind the music."}</h2>
      <p>{isPair ? "Two original photographs of Justin." : "An original portrait of Justin."}</p>
    </header>

    <div class="artist-photos__grid">
      <figure>
        <div class="artist-photos__frame">
          <Image
            src={portrait}
            alt="Justin LeBlanc in a plaid shirt beside an upright guitar"
            widths={[480, 720, 960, 1200]}
            sizes={isPair ? "(min-width: 60rem) 38rem, calc(100vw - 2.5rem)" : "(min-width: 64rem) 64rem, calc(100vw - 2.5rem)"}
            layout="constrained"
            loading="lazy"
            decoding="async"
            format="webp"
          />
        </div>
        <figcaption>Justin with an upright guitar.</figcaption>
      </figure>

      {isPair && (
        <figure>
          <div class="artist-photos__frame">
            <Image
              src={playingGuitar}
              alt="Justin LeBlanc smiling while playing a guitar"
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 60rem) 38rem, calc(100vw - 2.5rem)"
              layout="constrained"
              loading="lazy"
              decoding="async"
              format="webp"
            />
          </div>
          <figcaption>Justin playing guitar.</figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .artist-photos {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background:
      linear-gradient(135deg, rgba(49, 93, 245, 0.08), transparent 44%),
      var(--paper);
  }

  .artist-photos__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.55fr);
    gap: 0 clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .artist-photos__heading .eyebrow {
    grid-column: 1 / -1;
  }

  .artist-photos__heading h2,
  .artist-photos__heading > p:last-child {
    margin-bottom: 0;
  }

  .artist-photos__heading > p:last-child {
    color: var(--muted);
  }

  .artist-photos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .artist-photos--portrait .artist-photos__grid {
    grid-template-columns: minmax(0, 64rem);
  }

  figure {
    margin: 0;
  }

  .artist-photos__frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-light);
    box-shadow: var(--shadow);
  }

  .artist-photos__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  figcaption {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 48rem) {
    .artist-photos__heading,
    .artist-photos__grid {
      grid-template-columns: 1fr;
    }

    .artist-photos__heading {
      gap: 0.7rem;
    }
  }
</style>
