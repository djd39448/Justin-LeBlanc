---
/**
 * Renders concise navigation and verified public links.
 *
 * Dependencies: Shared reviewed site content.
 * Depended on by: BaseLayout.
 * Why this exists: Visitors need a clear route to planning, listening, and following Justin.
 */
import { site } from "../content";
---

<footer class="site-footer">
  <div class="footer-grid page-shell">
    <div>
      <a class="wordmark footer-mark" href="/"><span>Justin</span> LeBlanc</a>
      <p>Music shaped around your room, your guests, and the moments they will remember.</p>
    </div>
    <nav aria-label="Footer">
      <a href="/#listen">Listen</a>
      <a href="/#follow">Follow</a>
      <a href="/faq/">FAQ</a>
      <a href="/privacy/">Privacy</a>
      <a href="/#plan-your-event">Plan your event</a>
    </nav>
    <div>
      <p class="footer-label">Follow Justin</p>
      <a href={site.currentSite} rel="external">Current website</a>
      <a href={site.instagram} rel="external">Instagram</a>
      <a href={site.youtube} rel="external">YouTube</a>
      <a href={site.facebook} rel="external">Facebook</a>
    </div>
  </div>
  <div class="footer-bottom page-shell">
    <span>© 2026 Justin LeBlanc</span>
  </div>
</footer>
