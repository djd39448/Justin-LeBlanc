---
/**
 * Renders and submits the three-step accessible discovery form.
 *
 * Dependencies: The shared InquiryInput API contract at /api/inquiries.
 * Depended on by: Home and plan-your-event pages.
 * Why this exists: A structured, resumable inquiry captures useful detail without requiring unknowns.
 */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={["planner", compact && "planner-compact"]} aria-labelledby="planner-title">
  <div class="section-heading planner-heading">
    <div>
      <p class="eyebrow">Tell us what you know</p>
      <h2 id="planner-title">Plan the music around your event</h2>
    </div>
    <p>
      Three short steps. Unknown details can stay unknown. An inquiry starts the conversation; it
      does not confirm a date or price.
    </p>
  </div>

  <noscript>
    <div class="notice notice-warning">
      JavaScript is off, so step guidance and browser saving are unavailable. You can still read the
      complete form below, or use Justin's{" "}
      <a href="https://justinleblancmusic.com/contact" rel="external">current contact page</a> to
      send an inquiry.
    </div>
  </noscript>

  <form
    class="planner-form"
    id="event-planner"
    action="/api/inquiries"
    method="post"
    data-current-step="1"
  >
    <div class="planner-progress" aria-label="Form progress">
      <p><span id="progress-label">Step 1 of 3</span><span id="save-state">Saved as you go</span></p>
      <ol>
        <li class="is-current" data-progress-step="1"><span>1</span> Contact</li>
        <li data-progress-step="2"><span>2</span> Event</li>
        <li data-progress-step="3"><span>3</span> Details & review</li>
      </ol>
    </div>

    <div class="form-alert" id="form-alert" role="alert" tabindex="-1" hidden></div>

    <fieldset class="form-step" data-step="1">
      <legend>How should we follow up?</legend>
      <div class="field-grid">
        <div class="field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" autocomplete="name" maxlength="200" required />
        </div>
        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field">
          <label for="preferredReply">Preferred reply <span aria-hidden="true">*</span></label>
          <select id="preferredReply" name="preferredReply" required>
            <option value="email">Email</option>
            <option value="phone">Phone consultation</option>
          </select>
        </div>
        <div class="field">
          <label for="phone">Phone <span id="phone-optional">(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          <p class="form-hint">Required only if you choose a phone consultation.</p>
        </div>
        <div class="field field-wide">
          <label for="company">Company or planning role (optional)</label>
          <input id="company" name="company" autocomplete="organization" maxlength="200" />
        </div>
      </div>
      <div class="form-actions form-actions-end">
        <button class="button" type="button" data-next-step="2">Continue to event</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="2">
      <legend>What are you planning?</legend>
      <div class="field-grid">
        <div class="field">
          <label for="eventType">Event type <span aria-hidden="true">*</span></label>
          <select id="eventType" name="eventType" required>
            <option value="">Choose one</option>
            <option value="private">Private gathering</option>
            <option value="celebration">Celebration</option>
            <option value="corporate">Corporate reception</option>
            <option value="wedding">Wedding</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="city">Event city <span aria-hidden="true">*</span></label>
          <input id="city" name="city" autocomplete="address-level2" maxlength="200" required />
        </div>
        <div class="field">
          <label for="eventDate">Event date</label>
          <input id="eventDate" name="eventDate" type="date" required />
          <label class="check-row" for="dateFlexible">
            <input id="dateFlexible" name="dateFlexible" type="checkbox" />
            <span>My date is flexible or not chosen yet</span>
          </label>
        </div>
        <div class="field">
          <label for="venue">Venue name (optional)</label>
          <input id="venue" name="venue" maxlength="200" />
        </div>
        <div class="field">
          <label for="setting">Setting</label>
          <select id="setting" name="setting">
            <option value="unknown">Not sure yet</option>
            <option value="indoor">Indoors</option>
            <option value="outdoor">Outdoors</option>
          </select>
        </div>
        <div class="field">
          <label for="guestCount">Approximate guest count (optional)</label>
          <input id="guestCount" name="guestCount" type="number" min="1" max="10000" inputmode="numeric" />
        </div>
      </div>
      <div class="form-actions">
        <button class="button button-secondary" type="button" data-back-step="1">Back</button>
        <button class="button" type="button" data-next-step="3">Continue to details</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="3">
      <legend>Shape the atmosphere, then review</legend>
      <div class="field-grid">
        <div class="field field-wide">
          <label for="atmosphere">What should the room feel like? <span aria-hidden="true">*</span></label>
          <input
            id="atmosphere"
            name="atmosphere"
            maxlength="200"
            placeholder="Warm and conversational, celebratory, relaxed…"
            required
          />
        </div>
        <div class="field">
          <label for="durationMinutes">Approximate performance time</label>
          <select id="durationMinutes" name="durationMinutes" required>
            <option value="60">About 1 hour</option>
            <option value="120" selected>About 2 hours</option>
            <option value="180">About 3 hours</option>
            <option value="240">About 4 hours</option>
          </select>
        </div>
        <div class="field">
          <label for="timezone">Event timezone</label>
          <select id="timezone" name="timezone" required>
            <option value="America/Chicago" selected>Central time</option>
            <option value="America/New_York">Eastern time</option>
            <option value="America/Denver">Mountain time</option>
            <option value="America/Los_Angeles">Pacific time</option>
          </select>
        </div>
        <div class="field field-wide">
          <label for="musicRequests">Music or event-moment requests (optional)</label>
          <textarea id="musicRequests" name="musicRequests" rows="3" maxlength="800"></textarea>
        </div>
        <div class="field">
          <label for="equipment">Sound or equipment needs</label>
          <select id="equipment" name="equipment">
            <option value="unknown">Not sure yet</option>
            <option value="Venue sound may be available">Venue sound may be available</option>
            <option value="Please discuss sound needs">Please discuss sound needs</option>
          </select>
        </div>
        <div class="field">
          <label for="access">Venue access</label>
          <select id="access" name="access">
            <option value="unknown">Not sure yet</option>
            <option value="Easy ground-level access">Easy ground-level access</option>
            <option value="Access details need discussion">Access details need discussion</option>
          </select>
        </div>
        <div class="field">
          <label for="budget">Budget guidance</label>
          <select id="budget" name="budget">
            <option value="unsure">Not sure yet</option>
            <option value="Under $750">Under $750</option>
            <option value="$750–$1,250">$750–$1,250</option>
            <option value="$1,250–$2,000">$1,250–$2,000</option>
            <option value="Over $2,000">Over $2,000</option>
          </select>
        </div>
        <div class="field">
          <label for="scheduleNotes">Timing notes (optional)</label>
          <input id="scheduleNotes" name="scheduleNotes" maxlength="800" placeholder="Guest arrival, curfew, flexible timing…" />
        </div>
        <div class="field field-wide">
          <label for="notes">Anything else that would help? (optional)</label>
          <textarea id="notes" name="notes" rows="3" maxlength="800"></textarea>
        </div>
      </div>

      <div class="review-card" aria-labelledby="review-title">
        <div class="review-heading">
          <h3 id="review-title">Your inquiry at a glance</h3>
          <button class="text-button" type="button" data-back-step="1">Edit contact</button>
          <button class="text-button" type="button" data-back-step="2">Edit event</button>
        </div>
        <dl id="inquiry-summary"></dl>
      </div>

      <label class="check-row consent-row" for="consent">
        <input id="consent" name="consent" type="checkbox" required />
        <span>I agree to be contacted about this event inquiry. <span aria-hidden="true">*</span></span>
      </label>
      <label class="check-row" for="marketingConsent">
        <input id="marketingConsent" name="marketingConsent" type="checkbox" />
        <span>Also send occasional music and public-show updates. Optional and unchecked.</span>
      </label>

      <div class="form-actions">
        <button class="button button-secondary" type="button" data-back-step="2">Back</button>
        <button class="button" id="submit-inquiry" type="submit">Send inquiry</button>
      </div>
      <p class="form-hint form-hint-center">
        Submission creates an inquiry, not a confirmed booking or charge.
      </p>
    </fieldset>
  </form>

  <section class="schedule-card" id="schedule-card" aria-labelledby="schedule-title" tabindex="-1" hidden>
    <div class="schedule-card-heading">
      <div>
        <p class="eyebrow">Next step</p>
        <h3 id="schedule-title">Choose a consultation and tentative event time</h3>
      </div>
      <p class="reference-code" id="schedule-reference"></p>
    </div>
    <p>
      These are separate calendar entries. The event remains tentative until a person completes the
      consultation, agrees the quote, and confirms the show.
    </p>
    <div class="form-alert" id="schedule-alert" role="alert" tabindex="-1" hidden></div>
    <form id="schedule-form">
      <div class="field-grid">
        <div class="field">
          <label for="consultationLocal">Consultation date and time</label>
          <input id="consultationLocal" name="consultationLocal" type="datetime-local" required />
          <p class="form-hint">Demo consultation length: 20 minutes.</p>
        </div>
        <div class="field">
          <label for="scheduleTimezone">Event timezone</label>
          <select id="scheduleTimezone" name="scheduleTimezone" required>
            <option value="America/Chicago">Central time</option>
            <option value="America/New_York">Eastern time</option>
            <option value="America/Denver">Mountain time</option>
            <option value="America/Los_Angeles">Pacific time</option>
          </select>
        </div>
        <div class="field">
          <label for="performanceStartLocal">Tentative performance start</label>
          <input id="performanceStartLocal" name="performanceStartLocal" type="datetime-local" required />
        </div>
        <div class="field">
          <label for="performanceEndLocal">Tentative performance end</label>
          <input id="performanceEndLocal" name="performanceEndLocal" type="datetime-local" required />
        </div>
      </div>
      <div class="form-actions form-actions-end">
        <button class="button button-secondary" id="check-availability" type="button">Check both times</button>
      </div>
      <div class="availability-result" id="availability-result" hidden>
        <h4>Review both calendar requests</h4>
        <dl id="schedule-summary"></dl>
        <label class="check-row consent-row" for="reviewConsent">
          <input id="reviewConsent" name="reviewConsent" type="checkbox" />
          <span>
            I reviewed both dates and understand the performance is a tentative hold, not a confirmed
            booking.
          </span>
        </label>
        <button class="button" id="create-booking" type="submit" disabled>
          Create consultation + tentative hold
        </button>
      </div>
    </form>
  </section>
</section>

<script>
  /**
   * Coordinates form steps, browser-local recovery, and the validated inquiry API boundary.
   * The server remains authoritative for validation and persistence.
   */
  import type { InquiryInput } from "../../../../packages/contracts/index";

  type InquiryResponse = {
    id: string;
    token: string;
    status: string;
    missingFields: string[];
  };

  type ResumeRecord = {
    id: string;
    token: string;
    status: string;
    requestKey: string;
  };

  type CheckedSchedule = {
    consultationStart: string;
    performanceStart: string;
    performanceEnd: string;
    timezone: string;
  };

  type AvailabilityResponse = {
    consultationAvailable: boolean;
    performanceAvailable: boolean;
    reasons: string[];
  };

  type BookingResponse = {
    inquiryId: string;
    showId: string;
    consultationId: string;
    status: string;
    replayed: boolean;
  };

  const STORAGE_KEY = "justin-demo-inquiry-draft-v1";
  const RESUME_KEY = "justin-demo-inquiry-resume-v1";
  const planner = document.querySelector<HTMLFormElement>("#event-planner");
  const alertBox = document.querySelector<HTMLDivElement>("#form-alert");
  const progressLabel = document.querySelector<HTMLSpanElement>("#progress-label");
  const saveState = document.querySelector<HTMLSpanElement>("#save-state");
  const summary = document.querySelector<HTMLDListElement>("#inquiry-summary");
  const preferredReply = document.querySelector<HTMLSelectElement>("#preferredReply");
  const phone = document.querySelector<HTMLInputElement>("#phone");
  const phoneOptional = document.querySelector<HTMLSpanElement>("#phone-optional");
  const dateFlexible = document.querySelector<HTMLInputElement>("#dateFlexible");
  const eventDate = document.querySelector<HTMLInputElement>("#eventDate");
  const submitButton = document.querySelector<HTMLButtonElement>("#submit-inquiry");
  const scheduleCard = document.querySelector<HTMLElement>("#schedule-card");
  const scheduleReference = document.querySelector<HTMLParagraphElement>("#schedule-reference");
  const scheduleAlert = document.querySelector<HTMLDivElement>("#schedule-alert");
  const scheduleForm = document.querySelector<HTMLFormElement>("#schedule-form");
  const scheduleTimezone = document.querySelector<HTMLSelectElement>("#scheduleTimezone");
  const checkAvailabilityButton = document.querySelector<HTMLButtonElement>("#check-availability");
  const availabilityResult = document.querySelector<HTMLDivElement>("#availability-result");
  const scheduleSummary = document.querySelector<HTMLDListElement>("#schedule-summary");
  const reviewConsent = document.querySelector<HTMLInputElement>("#reviewConsent");
  const createBookingButton = document.querySelector<HTMLButtonElement>("#create-booking");
  let checkedSchedule: CheckedSchedule | null = null;

  function requirePlannerElements(): void {
    if (
      !planner ||
      !alertBox ||
      !progressLabel ||
      !saveState ||
      !summary ||
      !preferredReply ||
      !phone ||
      !phoneOptional ||
      !dateFlexible ||
      !eventDate ||
      !submitButton
    ) {
      throw new Error(
        "Event planner did not initialize because a required form element is missing. Rebuild the web app and inspect EventPlanner.astro."
      );
    }
  }

  function showAlert(message: string, kind: "error" | "success"): void {
    if (!alertBox) return;
    alertBox.hidden = false;
    alertBox.className = `form-alert form-alert-${kind}`;
    alertBox.textContent = message;
    alertBox.focus();
  }

  function clearAlert(): void {
    if (!alertBox) return;
    alertBox.hidden = true;
    alertBox.textContent = "";
  }

  function updateConditionalFields(): void {
    if (!preferredReply || !phone || !phoneOptional || !dateFlexible || !eventDate) return;
    const phoneRequired = preferredReply.value === "phone";
    phone.required = phoneRequired;
    phoneOptional.textContent = phoneRequired ? "*" : "(optional)";
    eventDate.required = !dateFlexible.checked;
    eventDate.disabled = dateFlexible.checked;
  }

  function controlValue(name: string): string {
    if (!planner) return "";
    const control = planner.elements.namedItem(name);
    if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) {
      return control.value.trim();
    }
    return "";
  }

  function renderSummary(): void {
    if (!summary || !dateFlexible) return;
    const eventType = document.querySelector<HTMLSelectElement>("#eventType");
    const setting = document.querySelector<HTMLSelectElement>("#setting");
    const rows = [
      ["Contact", `${controlValue("name")} · ${controlValue("email")}`],
      ["Event", eventType && eventType.selectedOptions[0] ? eventType.selectedOptions[0].text : ""],
      ["Date", dateFlexible.checked ? "Flexible / not chosen" : controlValue("eventDate")],
      ["Place", [controlValue("venue"), controlValue("city")].filter(Boolean).join(", ")],
      ["Setting", setting && setting.selectedOptions[0] ? setting.selectedOptions[0].text : "Not sure yet"],
      ["Atmosphere", controlValue("atmosphere") || "Add below"]
    ];
    summary.replaceChildren();
    for (const [term, value] of rows) {
      const wrapper = document.createElement("div");
      const dt = document.createElement("dt");
      const dd = document.createElement("dd");
      dt.textContent = term;
      dd.textContent = value || "Not provided";
      wrapper.append(dt, dd);
      summary.append(wrapper);
    }
  }

  function showStep(step: number, focusControl = true): void {
    if (!planner || !progressLabel) return;
    const steps = planner.querySelectorAll<HTMLElement>("[data-step]");
    const progressItems = planner.querySelectorAll<HTMLElement>("[data-progress-step]");
    for (const panel of steps) panel.hidden = Number(panel.dataset.step) !== step;
    for (const item of progressItems) {
      const itemStep = Number(item.dataset.progressStep);
      item.classList.toggle("is-current", itemStep === step);
      item.classList.toggle("is-complete", itemStep < step);
    }
    planner.dataset.currentStep = String(step);
    progressLabel.textContent = `Step ${step} of 3`;
    if (step === 3) renderSummary();
    const activeControl = planner.querySelector<HTMLElement>(
      `[data-step="${step}"] input, [data-step="${step}"] select, [data-step="${step}"] textarea`
    );
    if (activeControl && focusControl) activeControl.focus();
    clearAlert();
  }

  function validateStep(step: number): boolean {
    if (!planner) return false;
    updateConditionalFields();
    const panel = planner.querySelector<HTMLElement>(`[data-step="${step}"]`);
    if (!panel) return false;
    const controls = panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      "input, select, textarea"
    );
    for (const control of controls) {
      if (!control.checkValidity()) {
        control.reportValidity();
        return false;
      }
    }
    return true;
  }

  function saveDraft(): void {
    if (!planner || !saveState) return;
    const saved: Record<string, string | boolean> = {};
    const controls = planner.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      "input[name], select[name], textarea[name]"
    );
    for (const control of controls) {
      saved[control.name] = control instanceof HTMLInputElement && control.type === "checkbox" ? control.checked : control.value;
    }
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      saveState.textContent = "Saved in this browser";
    } catch (error) {
      saveState.textContent = "Browser saving unavailable";
      console.error("Inquiry draft could not be saved. Check browser storage permissions.", error);
    }
  }

  function restoreDraft(): void {
    if (!planner || !saveState) return;
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw) as Record<string, unknown>;
      for (const [name, value] of Object.entries(saved)) {
        const control = planner.elements.namedItem(name);
        if (control instanceof HTMLInputElement && control.type === "checkbox") {
          control.checked = value === true;
        } else if (
          typeof value === "string" &&
          (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement)
        ) {
          control.value = value;
        }
      }
      saveState.textContent = "Draft resumed in this browser";
    } catch (error) {
      saveState.textContent = "Saved draft could not be read";
      console.error("Inquiry draft recovery failed. Clear the saved browser draft and retry.", error);
    }
  }

  function nullableInteger(name: string): number | null {
    const value = controlValue(name);
    if (!value) return null;
    const parsed = Number.parseInt(value, 10);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function buildPayload(): InquiryInput {
    if (!dateFlexible || !planner) {
      throw new Error("Cannot build inquiry payload because the event planner is unavailable.");
    }
    const params = new URLSearchParams(window.location.search);
    return {
      name: controlValue("name"),
      email: controlValue("email"),
      phone: controlValue("phone"),
      preferredReply: controlValue("preferredReply") === "phone" ? "phone" : "email",
      company: controlValue("company"),
      eventType: controlValue("eventType") as InquiryInput["eventType"],
      date: dateFlexible.checked ? "flexible" : controlValue("eventDate"),
      city: controlValue("city"),
      venue: controlValue("venue"),
      address: "",
      setting: controlValue("setting") as InquiryInput["setting"],
      guestCount: nullableInteger("guestCount"),
      startLocal: "",
      endLocal: "",
      durationMinutes: Number.parseInt(controlValue("durationMinutes"), 10),
      timezone: controlValue("timezone"),
      atmosphere: controlValue("atmosphere"),
      musicRequests: controlValue("musicRequests"),
      scheduleNotes: controlValue("scheduleNotes"),
      equipment: controlValue("equipment"),
      access: controlValue("access"),
      budget: controlValue("budget"),
      notes: controlValue("notes"),
      consent: true,
      marketingConsent: planner.elements.namedItem("marketingConsent") instanceof HTMLInputElement
        ? (planner.elements.namedItem("marketingConsent") as HTMLInputElement).checked
        : false,
      source: "form",
      utm: {
        source: params.get("utm_source") || undefined,
        medium: params.get("utm_medium") || undefined,
        campaign: params.get("utm_campaign") || undefined
      }
    };
  }

  function isInquiryResponse(value: unknown): value is InquiryResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record.id === "string" &&
      typeof record.token === "string" &&
      typeof record.status === "string" &&
      Array.isArray(record.missingFields)
    );
  }

  function isAvailabilityResponse(value: unknown): value is AvailabilityResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record.consultationAvailable === "boolean" &&
      typeof record.performanceAvailable === "boolean" &&
      Array.isArray(record.reasons) &&
      record.reasons.every((reason) => typeof reason === "string")
    );
  }

  function isBookingResponse(value: unknown): value is BookingResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record.inquiryId === "string" &&
      typeof record.showId === "string" &&
      typeof record.consultationId === "string" &&
      typeof record.status === "string" &&
      typeof record.replayed === "boolean"
    );
  }

  function makeRequestKey(): string {
    if (typeof crypto.randomUUID === "function") return crypto.randomUUID();
    return `web-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  function readResumeRecord(): ResumeRecord | null {
    try {
      const raw = sessionStorage.getItem(RESUME_KEY);
      if (!raw) return null;
      const value: unknown = JSON.parse(raw);
      if (typeof value !== "object" || value === null) return null;
      const record = value as Record<string, unknown>;
      if (typeof record.id !== "string" || typeof record.token !== "string" || typeof record.status !== "string") {
        return null;
      }
      const requestKey = typeof record.requestKey === "string" ? record.requestKey : makeRequestKey();
      return { id: record.id, token: record.token, status: record.status, requestKey };
    } catch (error) {
      console.error("Inquiry resume record could not be read. Clear session storage and retry.", error);
      return null;
    }
  }

  function persistResumeRecord(record: ResumeRecord): void {
    sessionStorage.setItem(RESUME_KEY, JSON.stringify(record));
  }

  function showScheduleAlert(message: string, kind: "error" | "success"): void {
    if (!scheduleAlert) return;
    scheduleAlert.hidden = false;
    scheduleAlert.className = `form-alert form-alert-${kind}`;
    scheduleAlert.textContent = message;
    scheduleAlert.focus();
  }

  function clearScheduleAlert(): void {
    if (!scheduleAlert) return;
    scheduleAlert.hidden = true;
    scheduleAlert.textContent = "";
  }

  function activateScheduling(record: ResumeRecord, focusCard: boolean): void {
    if (!scheduleCard || !scheduleReference) return;
    persistResumeRecord(record);
    scheduleCard.hidden = false;
    scheduleReference.textContent = `Inquiry ${record.id}`;
    if (scheduleTimezone && controlValue("timezone")) scheduleTimezone.value = controlValue("timezone");
    if (focusCard) {
      scheduleCard.scrollIntoView({ behavior: "smooth", block: "start" });
      scheduleCard.focus();
    }
  }

  async function responseJson(response: Response, context: string): Promise<unknown> {
    try {
      return await response.json();
    } catch (error) {
      throw new Error(`${context} returned HTTP ${response.status} without JSON.`, { cause: error });
    }
  }

  async function convertLocalTime(local: string, timezone: string): Promise<string> {
    const response = await fetch("/api/time", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ local, timezone })
    });
    const body = await responseJson(response, "Time conversion API");
    if (!response.ok || typeof body !== "object" || body === null || typeof (body as Record<string, unknown>).instant !== "string") {
      throw new Error(`Time conversion failed with HTTP ${response.status}. Check the local time and timezone.`);
    }
    return (body as { instant: string }).instant;
  }

  function scheduleValue(name: string): string {
    if (!scheduleForm) return "";
    const control = scheduleForm.elements.namedItem(name);
    if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) return control.value;
    return "";
  }

  function renderScheduleSummary(schedule: CheckedSchedule): void {
    if (!scheduleSummary) return;
    const rows = [
      ["Consultation", `${scheduleValue("consultationLocal")} · ${schedule.timezone}`],
      ["Tentative event", `${scheduleValue("performanceStartLocal")} to ${scheduleValue("performanceEndLocal")} · ${schedule.timezone}`],
      ["Status", "Consultation request + tentative performance hold"]
    ];
    scheduleSummary.replaceChildren();
    for (const [term, value] of rows) {
      const wrapper = document.createElement("div");
      const dt = document.createElement("dt");
      const dd = document.createElement("dd");
      dt.textContent = term;
      dd.textContent = value;
      wrapper.append(dt, dd);
      scheduleSummary.append(wrapper);
    }
  }

  function invalidateAvailability(): void {
    checkedSchedule = null;
    if (availabilityResult) availabilityResult.hidden = true;
    if (reviewConsent) reviewConsent.checked = false;
    if (createBookingButton) createBookingButton.disabled = true;
    clearScheduleAlert();
  }

  async function checkScheduleAvailability(): Promise<void> {
    if (!scheduleForm || !checkAvailabilityButton || !availabilityResult || !reviewConsent || !createBookingButton) return;
    if (!scheduleForm.reportValidity()) return;
    const timezone = scheduleValue("scheduleTimezone");
    const consultationLocal = scheduleValue("consultationLocal");
    const performanceStartLocal = scheduleValue("performanceStartLocal");
    const performanceEndLocal = scheduleValue("performanceEndLocal");
    if (performanceEndLocal <= performanceStartLocal) {
      showScheduleAlert("Performance end must be later than performance start. Adjust the event times and check again.", "error");
      return;
    }
    checkAvailabilityButton.disabled = true;
    checkAvailabilityButton.textContent = "Checking…";
    clearScheduleAlert();
    try {
      const [consultationStart, performanceStart, performanceEnd] = await Promise.all([
        convertLocalTime(consultationLocal, timezone),
        convertLocalTime(performanceStartLocal, timezone),
        convertLocalTime(performanceEndLocal, timezone)
      ]);
      const candidate = { consultationStart, performanceStart, performanceEnd, timezone };
      const response = await fetch("/api/availability", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ consultationStart, performanceStart, performanceEnd })
      });
      const body = await responseJson(response, "Availability API");
      if (!response.ok || !isAvailabilityResponse(body)) {
        throw new Error(`Availability API returned HTTP ${response.status} without a valid result.`);
      }
      if (!body.consultationAvailable || !body.performanceAvailable) {
        const reasonText = body.reasons.length > 0 ? body.reasons.join(" ") : "One or both times are unavailable.";
        showScheduleAlert(`${reasonText} Choose different times and check again.`, "error");
        return;
      }
      checkedSchedule = candidate;
      renderScheduleSummary(candidate);
      availabilityResult.hidden = false;
      reviewConsent.checked = false;
      createBookingButton.disabled = true;
      showScheduleAlert("Both times are currently available. Review the two requests before creating them.", "success");
    } catch (error) {
      console.error("Schedule availability check failed. Verify /api/time and /api/availability.", error);
      showScheduleAlert(
        "We could not verify both times. No consultation or hold was created. Check the entries and try again.",
        "error"
      );
    } finally {
      checkAvailabilityButton.disabled = false;
      checkAvailabilityButton.textContent = "Check both times";
    }
  }

  async function createSchedule(): Promise<void> {
    if (!checkedSchedule || !reviewConsent || !reviewConsent.checked || !createBookingButton) return;
    const resume = readResumeRecord();
    if (!resume) {
      showScheduleAlert("Secure inquiry resume details are missing. Submit the inquiry again before scheduling.", "error");
      return;
    }
    createBookingButton.disabled = true;
    createBookingButton.textContent = "Creating both entries…";
    try {
      const response = await fetch("/api/bookings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiryId: resume.id,
          token: resume.token,
          requestKey: resume.requestKey,
          ...checkedSchedule,
          reviewConsent: true
        })
      });
      const body = await responseJson(response, "Booking API");
      if (!response.ok || !isBookingResponse(body)) {
        throw new Error(`Booking API returned HTTP ${response.status} without persisted record IDs.`);
      }
      resume.status = body.status;
      persistResumeRecord(resume);
      if (scheduleForm) scheduleForm.hidden = true;
      showScheduleAlert(
        `Consultation ${body.consultationId} and tentative hold ${body.showId} are saved. Status: ${body.status}.`,
        "success"
      );
    } catch (error) {
      console.error("Consultation and hold creation failed. Verify /api/bookings and reconciliation state.", error);
      showScheduleAlert(
        "We could not verify creation of both calendar entries. Do not submit a new inquiry; retry this scheduling step so the service can reconcile safely.",
        "error"
      );
      createBookingButton.disabled = false;
      createBookingButton.textContent = "Retry consultation + tentative hold";
    }
  }

  async function submitInquiry(): Promise<void> {
    if (!planner || !submitButton) return;
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";
    clearAlert();
    try {
      const response = await fetch(planner.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildPayload())
      });
      const responseBody: unknown = await response.json();
      if (!response.ok || !isInquiryResponse(responseBody)) {
        throw new Error(`Inquiry API returned HTTP ${response.status} without a valid persisted record.`);
      }
      sessionStorage.setItem(
        RESUME_KEY,
        JSON.stringify({
          id: responseBody.id,
          token: responseBody.token,
          status: responseBody.status,
          requestKey: makeRequestKey()
        })
      );
      sessionStorage.removeItem(STORAGE_KEY);
      planner.replaceChildren();
      const confirmation = document.createElement("div");
      confirmation.className = "submission-confirmation";
      confirmation.tabIndex = -1;
      const heading = document.createElement("h3");
      heading.textContent = "Your inquiry is saved";
      const copy = document.createElement("p");
      copy.textContent =
        "A person still needs to confirm availability, format, and pricing. This browser holds the secure resume details for your inquiry.";
      const reference = document.createElement("p");
      reference.className = "reference-code";
      reference.textContent = `Inquiry reference: ${responseBody.id}`;
      confirmation.append(heading, copy, reference);
      planner.append(confirmation);
      confirmation.focus();
      const resume = readResumeRecord();
      if (resume) activateScheduling(resume, true);
    } catch (error) {
      console.error("Inquiry submission failed at /api/inquiries. Verify API health and request schema.", error);
      showAlert(
        "We could not save the inquiry to the booking service. Your answers remain saved in this browser. Please try again; no booking or charge was created.",
        "error"
      );
      submitButton.disabled = false;
      submitButton.textContent = "Try sending again";
    }
  }

  try {
    requirePlannerElements();
    const activePlanner = planner;
    if (!activePlanner) {
      throw new Error("Event planner form is missing after initialization checks.");
    }
    restoreDraft();
    updateConditionalFields();
    showStep(1, false);
    const existingResume = readResumeRecord();
    if (existingResume && existingResume.status !== "confirmed") activateScheduling(existingResume, false);
    activePlanner.addEventListener("input", () => {
      updateConditionalFields();
      saveDraft();
      if (activePlanner.dataset.currentStep === "3") renderSummary();
    });
    activePlanner.addEventListener("change", () => {
      updateConditionalFields();
      saveDraft();
      if (activePlanner.dataset.currentStep === "3") renderSummary();
    });
    activePlanner.querySelectorAll<HTMLButtonElement>("[data-next-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const currentStep = Number(activePlanner.dataset.currentStep || "1");
        const nextStep = Number(button.dataset.nextStep);
        if (validateStep(currentStep) && Number.isFinite(nextStep)) showStep(nextStep);
      });
    });
    activePlanner.querySelectorAll<HTMLButtonElement>("[data-back-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const backStep = Number(button.dataset.backStep);
        if (Number.isFinite(backStep)) showStep(backStep);
      });
    });
    activePlanner.addEventListener("submit", (event) => {
      event.preventDefault();
      if (validateStep(3)) void submitInquiry();
    });
    if (scheduleForm && checkAvailabilityButton && reviewConsent && createBookingButton) {
      scheduleForm
        .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
          "#consultationLocal, #scheduleTimezone, #performanceStartLocal, #performanceEndLocal"
        )
        .forEach((control) => control.addEventListener("input", invalidateAvailability));
      checkAvailabilityButton.addEventListener("click", () => void checkScheduleAvailability());
      reviewConsent.addEventListener("change", () => {
        createBookingButton.disabled = !reviewConsent.checked || checkedSchedule === null;
      });
      scheduleForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (scheduleForm.reportValidity()) void createSchedule();
      });
    }
  } catch (error) {
    console.error("Event planner initialization failed. Inspect the required element IDs.", error);
    showAlert(
      "The step-by-step planner could not start. Reload the page or use the contact links below.",
      "error"
    );
  }
</script>
