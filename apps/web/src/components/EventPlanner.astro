---
/**
 * Renders and submits the two-step accessible discovery form.
 *
 * Dependencies: The shared InquiryInput API contract at /api/inquiries.
 * Depended on by: Home and plan-your-event pages.
 * Why this exists: A structured, resumable inquiry captures useful detail without requiring unknowns.
 */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={["planner", compact && "planner-compact"]} aria-labelledby="planner-title">
  <div class="section-heading planner-heading">
    <div>
      <p class="eyebrow">Tell us what you know</p>
      <h2 id="planner-title">Plan the music around your event</h2>
    </div>
    <p>
      Two short steps. Unknown details can stay unknown. Sending this form starts a conversation;
      it does not confirm your date.
    </p>
  </div>

  <noscript>
    <div class="notice notice-warning">
      JavaScript is off, so step guidance and browser saving are unavailable. You can still read the
      complete form below, or use Justin's{" "}
      <a href="https://justinleblancmusic.com/contact" rel="external">current contact page</a> to
      send an inquiry.
    </div>
  </noscript>

  <form
    class="planner-form"
    id="event-planner"
    action="/api/inquiries"
    method="post"
    data-current-step="1"
  >
    <div class="planner-progress" aria-label="Form progress">
      <p><span id="progress-label">Step 1 of 2</span><span id="save-state">Saved as you go</span></p>
      <ol>
        <li class="is-current" data-progress-step="1"><span>1</span> Contact</li>
        <li data-progress-step="2"><span>2</span> Event & review</li>
      </ol>
    </div>

    <div class="form-alert" id="form-alert" role="alert" tabindex="-1" hidden></div>

    <fieldset class="form-step" data-step="1">
      <legend>How should we follow up?</legend>
      <div class="field-grid">
        <div class="field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" autocomplete="name" maxlength="200" required />
        </div>
        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field">
          <label for="preferredReply">Preferred Reply <span aria-hidden="true">*</span></label>
          <select id="preferredReply" name="preferredReply" required>
            <option value="email">Email</option>
            <option value="text">Text</option>
            <option value="phone">Phone Call</option>
          </select>
        </div>
        <div class="field">
          <label for="phone">Phone <span id="phone-optional">(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          <p class="form-hint">Required if you choose Text or Phone Call.</p>
        </div>
        <div class="field field-wide">
          <label for="company">Company or planning role (optional)</label>
          <input id="company" name="company" autocomplete="organization" maxlength="200" />
        </div>
      </div>
      <div class="form-actions form-actions-end">
        <button class="button" type="button" data-next-step="2">Continue to event</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="2">
      <legend>What are you planning?</legend>
      <div class="field-grid">
        <div class="field">
          <label for="eventType">Event type <span aria-hidden="true">*</span></label>
          <select id="eventType" name="eventType" required>
            <option value="">Choose one</option>
            <option value="private">Private gathering</option>
            <option value="celebration">Celebration</option>
            <option value="corporate">Corporate reception</option>
            <option value="wedding">Wedding</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="city">Location of the event <span aria-hidden="true">*</span></label>
          <input id="city" name="city" autocomplete="address-level2" maxlength="200" required />
        </div>
        <div class="field">
          <label for="eventDate">Event date</label>
          <input id="eventDate" name="eventDate" type="date" required />
          <label class="check-row" for="dateFlexible">
            <input id="dateFlexible" name="dateFlexible" type="checkbox" />
            <span>My date is flexible or not chosen yet</span>
          </label>
        </div>
        <div class="field">
          <label for="venue">Venue name (optional)</label>
          <input id="venue" name="venue" maxlength="200" />
        </div>
        <div class="field">
          <label for="setting">Setting</label>
          <select id="setting" name="setting">
            <option value="unknown">Not sure yet</option>
            <option value="indoor">Indoors</option>
            <option value="outdoor">Outdoors</option>
          </select>
        </div>
        <div class="field">
          <label for="guestCount">Approximate guest count (optional)</label>
          <input id="guestCount" name="guestCount" type="number" min="1" max="10000" inputmode="numeric" />
        </div>
        <div class="field">
          <label for="durationMinutes">Performance time</label>
          <select id="durationMinutes" name="durationMinutes" required>
            <option value="60">About 1 hour</option>
            <option value="120" selected>About 2 hours</option>
            <option value="180">About 3 hours</option>
            <option value="240">About 4 hours</option>
          </select>
        </div>
        <input id="timezone" name="timezone" type="hidden" value="America/Chicago" />
        <div class="field">
          <label for="equipment">Sound / equipment needs</label>
          <select id="equipment" name="equipment">
            <option value="unknown">Not sure yet</option>
            <option value="Venue provides PA">Venue provides PA</option>
            <option value="PA required">PA required</option>
          </select>
        </div>
        <div class="field">
          <label for="budgetCents">Budget (optional)</label>
          <input id="budgetCents" name="budgetCents" type="text" inputmode="decimal" autocomplete="off" maxlength="32" />
          <p class="form-hint">Planning context only; it is not a quote or a charge.</p>
          <p class="form-hint" id="legacy-budget-context" hidden></p>
        </div>
        <div class="field field-wide">
          <label for="musicRequests">Special requests (optional)</label>
          <textarea id="musicRequests" name="musicRequests" rows="3" maxlength="800"></textarea>
        </div>
      </div>

      <div class="review-card" aria-labelledby="review-title">
        <div class="review-heading">
          <h3 id="review-title">Your inquiry at a glance</h3>
          <button class="text-button" type="button" data-back-step="1">Edit contact</button>
        </div>
        <dl id="inquiry-summary"></dl>
      </div>

      <label class="check-row consent-row" for="consent">
        <input id="consent" name="consent" type="checkbox" required />
        <span>I agree to be contacted about this event inquiry. <span aria-hidden="true">*</span></span>
      </label>
      <label class="check-row" for="marketingConsent">
        <input id="marketingConsent" name="marketingConsent" type="checkbox" />
        <span>Also send occasional music and public-show updates. Optional and unchecked.</span>
      </label>

      <div class="form-actions">
        <button class="button button-secondary" type="button" data-back-step="1">Back</button>
        <button class="button" id="submit-inquiry" type="submit">Send inquiry</button>
      </div>
      <p class="form-hint form-hint-center">
        Sending this form starts a conversation; it does not confirm your date.
      </p>
    </fieldset>
  </form>
</section>

<script>
  /**
   * Coordinates form steps, browser-local recovery, and the validated inquiry API boundary.
   * The server remains authoritative for validation and persistence.
   */
  import type { InquiryInput } from "../../../../packages/contracts/index";

  type InquiryResponse = {
    id: string;
    token: string;
    status: string;
    missingFields: string[];
  };

  type ValidationErrorResponse = {
    error: "validation";
    message: string;
    fields: Array<{ path: string; message: string }>;
  };

  type InquiryInspection = {
    inquiryId: string;
    status: string;
    input: InquiryInput;
    shows: unknown[];
  };

  type ResumeRecord = {
    id: string;
    token: string;
    status: string;
    requestKey: string;
  };

  const STORAGE_KEY = "justin-demo-inquiry-draft-v1";
  const RESUME_KEY = "justin-demo-inquiry-resume-v1";
  const CENTRAL_TIME_ZONE = "America/Chicago";
  const planner = document.querySelector<HTMLFormElement>("#event-planner");
  const alertBox = document.querySelector<HTMLDivElement>("#form-alert");
  const progressLabel = document.querySelector<HTMLSpanElement>("#progress-label");
  const saveState = document.querySelector<HTMLSpanElement>("#save-state");
  const summary = document.querySelector<HTMLDListElement>("#inquiry-summary");
  const preferredReply = document.querySelector<HTMLSelectElement>("#preferredReply");
  const phone = document.querySelector<HTMLInputElement>("#phone");
  const phoneOptional = document.querySelector<HTMLSpanElement>("#phone-optional");
  const budgetInput = document.querySelector<HTMLInputElement>("#budgetCents");
  const legacyBudgetContext = document.querySelector<HTMLParagraphElement>("#legacy-budget-context");
  const dateFlexible = document.querySelector<HTMLInputElement>("#dateFlexible");
  const eventDate = document.querySelector<HTMLInputElement>("#eventDate");
  const submitButton = document.querySelector<HTMLButtonElement>("#submit-inquiry");
  const inquiryTimezone = document.querySelector<HTMLInputElement>("#timezone");
  let resumedInput: InquiryInput | null = null;
  let resumedLegacyBudget: string | null = null;
  let budgetWasEdited = false;
  let plannerWasEdited = false;

  function requirePlannerElements(): void {
    if (
      !planner ||
      !alertBox ||
      !progressLabel ||
      !saveState ||
      !summary ||
      !preferredReply ||
      !phone ||
      !phoneOptional ||
      !budgetInput ||
      !legacyBudgetContext ||
      !dateFlexible ||
      !eventDate ||
      !submitButton
    ) {
      throw new Error(
        "Event planner did not initialize because a required form element is missing. Rebuild the web app and inspect EventPlanner.astro."
      );
    }
  }

  function showAlert(message: string, kind: "error" | "success"): void {
    if (!alertBox) return;
    alertBox.hidden = false;
    alertBox.className = `form-alert form-alert-${kind}`;
    alertBox.textContent = message;
    alertBox.focus();
  }

  function clearAlert(): void {
    if (!alertBox) return;
    alertBox.hidden = true;
    alertBox.textContent = "";
  }

  function updateConditionalFields(): void {
    if (!preferredReply || !phone || !phoneOptional || !dateFlexible || !eventDate) return;
    const phoneRequired = preferredReply.value === "text" || preferredReply.value === "phone";
    phone.required = phoneRequired;
    if (!phoneRequired) phone.setCustomValidity("");
    phoneOptional.textContent = phoneRequired ? "*" : "(optional)";
    eventDate.required = !dateFlexible.checked;
    eventDate.disabled = dateFlexible.checked;
  }

  function controlValue(name: string): string {
    if (!planner) return "";
    const control = planner.elements.namedItem(name);
    if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) {
      return control.value.trim();
    }
    return "";
  }

  function renderSummary(): void {
    if (!summary || !dateFlexible) return;
    const eventType = document.querySelector<HTMLSelectElement>("#eventType");
    const setting = document.querySelector<HTMLSelectElement>("#setting");
    const preferredReplySelect = document.querySelector<HTMLSelectElement>("#preferredReply");
    const performanceTime = document.querySelector<HTMLSelectElement>("#durationMinutes");
    const equipment = document.querySelector<HTMLSelectElement>("#equipment");
    const budget = controlValue("budgetCents");
    const rows = [
      ["Contact", `${controlValue("name")} · ${controlValue("email")}`],
      ["Preferred reply", preferredReplySelect?.selectedOptions[0]?.text ?? "Email"],
      ["Event", eventType && eventType.selectedOptions[0] ? eventType.selectedOptions[0].text : ""],
      ["Date", dateFlexible.checked ? "Flexible / not chosen" : controlValue("eventDate")],
      ["Location", [controlValue("venue"), controlValue("city")].filter(Boolean).join(", ")],
      ["Setting", setting && setting.selectedOptions[0] ? setting.selectedOptions[0].text : "Not sure yet"],
      ["Guests", controlValue("guestCount")],
      ["Performance time", performanceTime?.selectedOptions[0]?.text ?? ""],
      ["Sound / equipment", equipment?.selectedOptions[0]?.text ?? "Not sure yet"],
      ["Budget", budget ? `$${budget}` : resumedLegacyBudget ?? ""],
      ["Special requests", controlValue("musicRequests")]
    ];
    summary.replaceChildren();
    for (const [term, value] of rows) {
      const wrapper = document.createElement("div");
      const dt = document.createElement("dt");
      const dd = document.createElement("dd");
      dt.textContent = term;
      dd.textContent = value || "Not provided";
      wrapper.append(dt, dd);
      summary.append(wrapper);
    }
  }

  function showStep(step: number, focusControl = true): void {
    if (!planner || !progressLabel) return;
    const steps = planner.querySelectorAll<HTMLElement>("[data-step]");
    const progressItems = planner.querySelectorAll<HTMLElement>("[data-progress-step]");
    for (const panel of steps) panel.hidden = Number(panel.dataset.step) !== step;
    for (const item of progressItems) {
      const itemStep = Number(item.dataset.progressStep);
      item.classList.toggle("is-current", itemStep === step);
      item.classList.toggle("is-complete", itemStep < step);
    }
    planner.dataset.currentStep = String(step);
    progressLabel.textContent = `Step ${step} of 2`;
    if (step === 2) renderSummary();
    const activeControl = planner.querySelector<HTMLElement>(
      `[data-step="${step}"] input, [data-step="${step}"] select, [data-step="${step}"] textarea`
    );
    if (activeControl && focusControl) activeControl.focus();
    clearAlert();
  }

  function applyServerValidation(value: unknown): boolean {
    if (!planner || !isValidationErrorResponse(value)) return false;
    let firstControl: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
    for (const issue of value.fields) {
      const control = planner.elements.namedItem(issue.path);
      if (
        control instanceof HTMLInputElement ||
        control instanceof HTMLSelectElement ||
        control instanceof HTMLTextAreaElement
      ) {
        control.setCustomValidity(issue.message);
        if (firstControl === null) firstControl = control;
      }
    }
    if (firstControl === null) return false;
    const panel = firstControl.closest<HTMLElement>("[data-step]");
    const step = panel === null ? Number.NaN : Number(panel.dataset.step);
    if (Number.isFinite(step)) showStep(step, false);
    showAlert(value.message, "error");
    firstControl.focus();
    firstControl.reportValidity();
    return true;
  }

  function validateStep(step: number): boolean {
    if (!planner) return false;
    updateConditionalFields();
    const panel = planner.querySelector<HTMLElement>(`[data-step="${step}"]`);
    if (!panel) return false;
    if (step === 2 && !validateBudget()) return false;
    const controls = panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      "input, select, textarea"
    );
    for (const control of controls) {
      if (!control.checkValidity()) {
        control.reportValidity();
        return false;
      }
    }
    return true;
  }

  function parseBudgetCents(value: string): number | null {
    const trimmed = value.trim();
    if (!trimmed) return null;
    if (!/^(?:0|[1-9][0-9]*)(?:\.[0-9]{1,2})?$/.test(trimmed)) {
      throw new Error("Enter a whole-dollar amount or up to two decimal places.");
    }
    const [dollars, decimals = ""] = trimmed.split(".");
    const cents = Number.parseInt(`${dollars}${decimals.padEnd(2, "0")}`, 10);
    if (!Number.isSafeInteger(cents) || cents > 9_999_999_999) {
      throw new Error("Enter an amount no greater than $99,999,999.99.");
    }
    return cents;
  }

  function validateBudget(): boolean {
    if (!budgetInput) return false;
    try {
      parseBudgetCents(budgetInput.value);
      budgetInput.setCustomValidity("");
      return true;
    } catch (error) {
      const message = error instanceof Error ? error.message : "Enter a valid estimated budget.";
      budgetInput.setCustomValidity(message);
      budgetInput.reportValidity();
      return false;
    }
  }

  function saveDraft(): void {
    if (!planner || !saveState) return;
    const saved: Record<string, string | boolean> = {};
    const controls = planner.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      "input[name], select[name], textarea[name]"
    );
    for (const control of controls) {
      saved[control.name] = control instanceof HTMLInputElement && control.type === "checkbox" ? control.checked : control.value;
    }
    saved.__budgetWasEdited = budgetWasEdited;
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      saveState.textContent = "Saved in this browser";
    } catch (error) {
      saveState.textContent = "Browser saving unavailable";
      console.error("Inquiry draft could not be saved. Check browser storage permissions.", error);
    }
  }

  function restoreDraft(): void {
    if (!planner || !saveState) return;
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw) as Record<string, unknown>;
      for (const [name, value] of Object.entries(saved)) {
        const control = planner.elements.namedItem(name);
        if (control instanceof HTMLInputElement && control.type === "checkbox") {
          control.checked = value === true;
        } else if (
          typeof value === "string" &&
          (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement)
        ) {
          control.value = value;
        }
      }
      plannerWasEdited = true;
      budgetWasEdited = saved.__budgetWasEdited === true;
      saveState.textContent = "Draft resumed in this browser";
    } catch (error) {
      saveState.textContent = "Saved draft could not be read";
      console.error("Inquiry draft recovery failed. Clear the saved browser draft and retry.", error);
    }
  }

  function setControlValue(name: string, value: string): void {
    if (!planner) return;
    const control = planner.elements.namedItem(name);
    if (
      control instanceof HTMLInputElement ||
      control instanceof HTMLSelectElement ||
      control instanceof HTMLTextAreaElement
    ) {
      control.value = value;
    }
  }

  function formatBudgetInput(cents: number): string {
    const dollars = Math.trunc(cents / 100).toString();
    const minor = (cents % 100).toString().padStart(2, "0");
    return `${dollars}.${minor}`;
  }

  function captureResumedBudget(input: InquiryInput, overwriteInput: boolean): void {
    if (!budgetInput || !legacyBudgetContext) return;
    resumedInput = input;
    if (input.budgetCents === null) {
      resumedLegacyBudget = input.budget.trim() === "" || input.budget === "unsure"
        ? null
        : input.budget;
      if (overwriteInput) budgetInput.value = "";
      const showLegacyContext =
        !budgetWasEdited && resumedLegacyBudget !== null && budgetInput.value.trim() === "";
      legacyBudgetContext.hidden = !showLegacyContext;
      legacyBudgetContext.textContent = showLegacyContext
        ? `Previous budget selection: ${resumedLegacyBudget}. Leave the amount blank to keep this context.`
        : "";
      return;
    }
    resumedLegacyBudget = null;
    if (overwriteInput || (!budgetWasEdited && budgetInput.value.trim() === "")) {
      budgetInput.value = formatBudgetInput(input.budgetCents);
    }
    legacyBudgetContext.hidden = true;
    legacyBudgetContext.textContent = "";
  }

  function applySubmittedInput(input: InquiryInput): void {
    if (!dateFlexible || !eventDate || !budgetInput || !legacyBudgetContext || !planner) return;
    for (const [name, value] of [
      ["name", input.name],
      ["email", input.email],
      ["phone", input.phone],
      ["preferredReply", input.preferredReply],
      ["company", input.company],
      ["eventType", input.eventType],
      ["city", input.city],
      ["venue", input.venue],
      ["setting", input.setting],
      ["durationMinutes", String(input.durationMinutes)],
      ["musicRequests", input.musicRequests],
      ["equipment", input.equipment]
    ]) {
      setControlValue(name, value);
    }
    setControlValue("guestCount", input.guestCount === null ? "" : String(input.guestCount));
    dateFlexible.checked = input.date === "flexible";
    eventDate.value = input.date === "flexible" ? "" : input.date;
    const consent = planner.elements.namedItem("consent");
    if (consent instanceof HTMLInputElement) consent.checked = input.consent;
    const marketing = planner.elements.namedItem("marketingConsent");
    if (marketing instanceof HTMLInputElement) marketing.checked = input.marketingConsent;

    budgetWasEdited = false;
    captureResumedBudget(input, true);
    updateConditionalFields();
    renderSummary();
  }

  async function restoreSubmittedInquiry(record: ResumeRecord): Promise<void> {
    if (!saveState) return;
    try {
      const response = await fetch(`/api/inquiries/${encodeURIComponent(record.id)}`, {
        headers: { Authorization: `Bearer ${record.token}`, Accept: "application/json" }
      });
      const body = await responseJson(response, "Inquiry resume API");
      if (!response.ok || !isInquiryInspection(body)) {
        throw new Error(`Inquiry resume API returned HTTP ${response.status} without a valid record.`);
      }
      record.status = body.status;
      persistResumeRecord(record);
      if (!plannerWasEdited) applySubmittedInput(body.input);
      else captureResumedBudget(body.input, false);
      saveState.textContent = plannerWasEdited
        ? "Saved inquiry available; current edits kept"
        : "Submitted inquiry resumed securely";
    } catch (error) {
      console.error("Submitted inquiry could not be resumed. Verify its saved token and /api/inquiries.", error);
      saveState.textContent = "Submitted inquiry could not be resumed";
    }
  }

  function nullableInteger(name: string): number | null {
    const value = controlValue(name);
    if (!value) return null;
    const parsed = Number.parseInt(value, 10);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function buildPayload(): InquiryInput {
    if (!dateFlexible || !planner) {
      throw new Error("Cannot build inquiry payload because the event planner is unavailable.");
    }
    const params = new URLSearchParams(window.location.search);
    const budgetCents = parseBudgetCents(controlValue("budgetCents"));
    const preserveLegacyBudget =
      resumedLegacyBudget !== null && !budgetWasEdited && budgetCents === null;
    return {
      name: controlValue("name"),
      email: controlValue("email"),
      phone: controlValue("phone"),
      preferredReply: controlValue("preferredReply") === "text"
        ? "text"
        : controlValue("preferredReply") === "phone"
          ? "phone"
          : "email",
      company: controlValue("company"),
      eventType: controlValue("eventType") as InquiryInput["eventType"],
      date: dateFlexible.checked ? "flexible" : controlValue("eventDate"),
      city: controlValue("city"),
      venue: controlValue("venue"),
      address: "",
      setting: controlValue("setting") as InquiryInput["setting"],
      guestCount: nullableInteger("guestCount"),
      startLocal: "",
      endLocal: "",
      durationMinutes: Number.parseInt(controlValue("durationMinutes"), 10),
      timezone: CENTRAL_TIME_ZONE,
      atmosphere: resumedInput?.atmosphere || "Not specified",
      musicRequests: controlValue("musicRequests"),
      scheduleNotes: resumedInput?.scheduleNotes || "",
      equipment: controlValue("equipment"),
      access: "unknown",
      budget: preserveLegacyBudget ? (resumedLegacyBudget ?? "unsure") : "unsure",
      budgetCents,
      notes: resumedInput?.notes || "",
      consent: true,
      marketingConsent: planner.elements.namedItem("marketingConsent") instanceof HTMLInputElement
        ? (planner.elements.namedItem("marketingConsent") as HTMLInputElement).checked
        : false,
      source: "form",
      utm: {
        source: params.get("utm_source") || resumedInput?.utm.source,
        medium: params.get("utm_medium") || resumedInput?.utm.medium,
        campaign: params.get("utm_campaign") || resumedInput?.utm.campaign
      }
    };
  }

  function isInquiryResponse(value: unknown): value is InquiryResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record.id === "string" &&
      typeof record.token === "string" &&
      typeof record.status === "string" &&
      Array.isArray(record.missingFields)
    );
  }

  function isValidationErrorResponse(value: unknown): value is ValidationErrorResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      record.error === "validation" &&
      typeof record.message === "string" &&
      Array.isArray(record.fields) &&
      record.fields.every((field) => {
        if (typeof field !== "object" || field === null) return false;
        const issue = field as Record<string, unknown>;
        return typeof issue.path === "string" && typeof issue.message === "string";
      })
    );
  }

  function isInquiryInspection(value: unknown): value is InquiryInspection {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    if (typeof record.input !== "object" || record.input === null) return false;
    const input = record.input as Record<string, unknown>;
    return (
      typeof record.inquiryId === "string" &&
      typeof record.status === "string" &&
      Array.isArray(record.shows) &&
      typeof input.name === "string" &&
      typeof input.email === "string" &&
      typeof input.preferredReply === "string" &&
      typeof input.budget === "string" &&
      (input.budgetCents === null || Number.isSafeInteger(input.budgetCents))
    );
  }

  function makeRequestKey(): string {
    if (typeof crypto.randomUUID === "function") return crypto.randomUUID();
    return `web-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  function readResumeRecord(): ResumeRecord | null {
    try {
      const raw = sessionStorage.getItem(RESUME_KEY);
      if (!raw) return null;
      const value: unknown = JSON.parse(raw);
      if (typeof value !== "object" || value === null) return null;
      const record = value as Record<string, unknown>;
      if (typeof record.id !== "string" || typeof record.token !== "string" || typeof record.status !== "string") {
        return null;
      }
      const requestKey = typeof record.requestKey === "string" ? record.requestKey : makeRequestKey();
      return { id: record.id, token: record.token, status: record.status, requestKey };
    } catch (error) {
      console.error("Inquiry resume record could not be read. Clear session storage and retry.", error);
      return null;
    }
  }

  function persistResumeRecord(record: ResumeRecord): void {
    sessionStorage.setItem(RESUME_KEY, JSON.stringify(record));
  }

  async function responseJson(response: Response, context: string): Promise<unknown> {
    try {
      return await response.json();
    } catch (error) {
      throw new Error(`${context} returned HTTP ${response.status} without JSON.`, { cause: error });
    }
  }

  async function submitInquiry(): Promise<void> {
    if (!planner || !submitButton) return;
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";
    clearAlert();
    try {
      const existingResume = readResumeRecord();
      const response = await fetch(
        existingResume === null
          ? planner.action
          : `/api/inquiries/${encodeURIComponent(existingResume.id)}`,
        {
        method: existingResume === null ? "POST" : "PUT",
        headers: {
          "Content-Type": "application/json",
          ...(existingResume === null
            ? {}
            : { Authorization: `Bearer ${existingResume.token}` })
        },
        body: JSON.stringify(buildPayload())
      });
      const responseBody = await responseJson(response, "Inquiry API");
      if (!response.ok) {
        if (applyServerValidation(responseBody)) {
          submitButton.disabled = false;
          submitButton.textContent = "Send inquiry";
          return;
        }
        throw new Error(`Inquiry API returned HTTP ${response.status} without actionable field errors.`);
      }
      if (!isInquiryResponse(responseBody)) {
        throw new Error(`Inquiry API returned HTTP ${response.status} without a valid persisted record.`);
      }
      persistResumeRecord({
        id: responseBody.id,
        token: responseBody.token,
        status: responseBody.status,
        requestKey: existingResume?.requestKey ?? makeRequestKey()
      });
      sessionStorage.removeItem(STORAGE_KEY);
      planner.replaceChildren();
      const confirmation = document.createElement("div");
      confirmation.className = "submission-confirmation";
      confirmation.tabIndex = -1;
      const heading = document.createElement("h3");
      heading.textContent = "Your inquiry is saved";
      const copy = document.createElement("p");
      copy.textContent =
        "Justin or his team will follow up using your selected reply method to confirm availability, format, and pricing. This browser holds the secure resume details for your inquiry.";
      const reference = document.createElement("p");
      reference.className = "reference-code";
      reference.textContent = `Inquiry reference: ${responseBody.id}`;
      confirmation.append(heading, copy, reference);
      planner.append(confirmation);
      confirmation.focus();
    } catch (error) {
      console.error("Inquiry submission failed at /api/inquiries. Verify API health and request schema.", error);
      showAlert(
        "We could not save the inquiry to the booking service. Your answers remain saved in this browser. Please try again; no booking or charge was created.",
        "error"
      );
      submitButton.disabled = false;
      submitButton.textContent = "Try sending again";
    }
  }

  try {
    requirePlannerElements();
    const activePlanner = planner;
    if (!activePlanner) {
      throw new Error("Event planner form is missing after initialization checks.");
    }
    restoreDraft();
    if (inquiryTimezone) inquiryTimezone.value = CENTRAL_TIME_ZONE;
    updateConditionalFields();
    showStep(1, false);
    const existingResume = readResumeRecord();
    if (existingResume) {
      void restoreSubmittedInquiry(existingResume);
    }
    activePlanner.addEventListener("input", (event) => {
      plannerWasEdited = true;
      const editedControl = event.target;
      if (
        editedControl instanceof HTMLInputElement ||
        editedControl instanceof HTMLSelectElement ||
        editedControl instanceof HTMLTextAreaElement
      ) {
        editedControl.setCustomValidity("");
      }
      if (budgetInput && event.target === budgetInput) {
        budgetWasEdited = true;
        if (legacyBudgetContext) {
          legacyBudgetContext.hidden = true;
          legacyBudgetContext.textContent = "";
        }
      }
      updateConditionalFields();
      saveDraft();
      if (activePlanner.dataset.currentStep === "2") renderSummary();
    });
    activePlanner.addEventListener("change", () => {
      plannerWasEdited = true;
      updateConditionalFields();
      saveDraft();
      if (activePlanner.dataset.currentStep === "2") renderSummary();
    });
    activePlanner.querySelectorAll<HTMLButtonElement>("[data-next-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const currentStep = Number(activePlanner.dataset.currentStep || "1");
        const nextStep = Number(button.dataset.nextStep);
        if (validateStep(currentStep) && Number.isFinite(nextStep)) showStep(nextStep);
      });
    });
    activePlanner.querySelectorAll<HTMLButtonElement>("[data-back-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const backStep = Number(button.dataset.backStep);
        if (Number.isFinite(backStep)) showStep(backStep);
      });
    });
    activePlanner.addEventListener("submit", (event) => {
      event.preventDefault();
      if (validateStep(2)) void submitInquiry();
    });
  } catch (error) {
    console.error("Event planner initialization failed. Inspect the required element IDs.", error);
    showAlert(
      "The step-by-step planner could not start. Reload the page or use the contact links below.",
      "error"
    );
  }
</script>
