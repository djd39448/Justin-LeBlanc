---
/**
 * Renders a progressively enhanced projection of upcoming public performances.
 *
 * Dependencies: The sanitized /api/public-events endpoint.
 * Depended on by: The homepage.
 * Why this exists: Visitors can find public performances without exposing private booking data.
 */
---

<section class="public-events section" aria-labelledby="public-events-title">
  <div class="page-shell">
    <div class="section-heading public-events__heading">
      <div>
        <p class="eyebrow">Upcoming dates</p>
        <h2 id="public-events-title">Where I’m Playing</h2>
      </div>
      <p>Public performances are listed here as they are confirmed for sharing.</p>
    </div>
    <div class="public-events__state" id="public-events-state" role="status" aria-live="polite">
      Loading upcoming public performances…
    </div>
    <ol class="public-events__list" id="public-events-list" hidden></ol>
  </div>
</section>

<script>
  type PublicEvent = {
    id: string;
    title: string;
    venue: string;
    city?: string;
    start: string;
    end: string;
    timezone: string;
  };

  type PublicEventsResponse = {
    events: PublicEvent[];
    status: "fresh" | "stale";
    lastUpdated: string;
  };

  const state = document.querySelector<HTMLElement>("#public-events-state");
  const list = document.querySelector<HTMLOListElement>("#public-events-list");

  function isResponse(value: unknown): value is PublicEventsResponse {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      Array.isArray(record.events) &&
      record.events.every(isPublicEvent) &&
      (record.status === "fresh" || record.status === "stale") &&
      typeof record.lastUpdated === "string"
    );
  }

  function isPublicEvent(value: unknown): value is PublicEvent {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return (
      typeof record.id === "string" &&
      typeof record.title === "string" &&
      typeof record.venue === "string" &&
      (record.city === undefined || typeof record.city === "string") &&
      typeof record.start === "string" &&
      typeof record.end === "string" &&
      typeof record.timezone === "string"
    );
  }

  function formatDate(value: string, timezone: string): string {
    return new Intl.DateTimeFormat("en-US", {
      weekday: "short",
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZone: timezone,
      timeZoneName: "short"
    }).format(new Date(value));
  }

  function renderEvents(events: PublicEvent[], status: "fresh" | "stale"): void {
    if (!state || !list) return;
    if (events.length === 0) {
      list.replaceChildren();
      list.hidden = true;
      state.hidden = false;
      state.textContent = "There are no upcoming public performances listed right now.";
      return;
    }
    list.replaceChildren();
    for (const event of events) {
      const item = document.createElement("li");
      const start = document.createElement("time");
      start.dateTime = event.start;
      start.textContent = formatDate(event.start, event.timezone);
      const end = document.createElement("time");
      end.dateTime = event.end;
      end.className = "visually-hidden";
      end.textContent = ` through ${formatDate(event.end, event.timezone)}`;
      const details = document.createElement("div");
      const title = document.createElement("h3");
      const venue = document.createElement("p");
      title.textContent = event.title;
      venue.textContent = event.city ? `${event.venue} · ${event.city}` : event.venue;
      details.append(title, venue);
      item.append(start, end, details);
      list.append(item);
    }
    list.hidden = false;
    state.textContent = status === "stale"
      ? "Showing the most recently confirmed public-performance listing while dates refresh."
      : "";
    state.hidden = status === "fresh";
  }

  async function loadEvents(): Promise<void> {
    if (!state) return;
    try {
      const response = await fetch("/api/public-events", { headers: { Accept: "application/json" } });
      const body: unknown = await response.json();
      if (!response.ok || !isResponse(body)) {
        throw new Error("Public performances are unavailable.");
      }
      renderEvents(body.events, body.status);
    } catch (error) {
      console.error("Could not load the public events projection. Check /api/public-events.", error);
      if (list) {
        list.replaceChildren();
        list.hidden = true;
      }
      state.hidden = false;
      state.textContent = "Current dates are temporarily unavailable.";
    }
  }

  void loadEvents();
</script>
