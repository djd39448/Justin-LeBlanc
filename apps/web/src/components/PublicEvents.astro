---
/**
 * Renders the temporary curated projection of upcoming public performances.
 *
 * Dependencies: Curated public listings verified from public sources.
 * Depended on by: The homepage.
 * Why this exists: Visitors can find verified public performances while Calendar sync stays
 * disabled until its dedicated QA pass.
 */
import { temporaryPublicEvents } from "../content";

const buildTime = Date.now();
const visiblePublicEvents = temporaryPublicEvents.filter((event) => {
  const endTime = Date.parse(event.end);
  if (!Number.isFinite(endTime)) {
    throw new Error(`Temporary public event ${event.id} has an invalid end time.`);
  }
  return endTime > buildTime;
});
const curatedState =
  "Dates currently confirmed on Justin’s public listings. More dates will be added as they are announced.";
const emptyState = "New public dates will be posted here soon.";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "America/Chicago",
  timeZoneName: "short"
});
---

<section class="public-events section" aria-labelledby="public-events-title">
  <div class="page-shell">
    <div class="section-heading public-events__heading">
      <div>
        <p class="eyebrow">Upcoming dates</p>
        <h2 id="public-events-title">Where I’m Playing</h2>
      </div>
      <p>Public performances are listed here as they are confirmed for sharing.</p>
    </div>
    <div class="public-events__state" id="public-events-state" role="status" aria-live="polite">
      {visiblePublicEvents.length > 0 ? curatedState : emptyState}
    </div>
    <ol class="public-events__list" id="public-events-list" hidden={visiblePublicEvents.length === 0}>
      {visiblePublicEvents.map((event) => (
        <li data-curated-event data-end={event.end}>
          <time datetime={event.start}>{dateFormatter.format(new Date(event.start))}</time>
          <time datetime={event.end} class="visually-hidden">
            {` through ${dateFormatter.format(new Date(event.end))}`}
          </time>
          <div>
            <h3>{event.title}</h3>
            <p>{event.venue} · {event.city}</p>
            <a class="public-events__source" href={event.sourceUrl} rel="external">Event details</a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const state = document.querySelector<HTMLElement>("#public-events-state");
  const list = document.querySelector<HTMLOListElement>("#public-events-list");
  const CURATED_STATE =
    "Dates currently confirmed on Justin’s public listings. More dates will be added as they are announced.";
  const EMPTY_PLACEHOLDER_STATE = "New public dates will be posted here soon.";
  const MAX_TIMEOUT_MS = 2_147_483_647;

  function pruneExpiredCuratedEvents(): number | null {
    if (!list) return null;
    let nextEndTime: number | null = null;
    const items = list.querySelectorAll<HTMLElement>("[data-curated-event]");
    for (const item of items) {
      const end = item.dataset.end;
      const endTime = end ? Date.parse(end) : Number.NaN;
      if (!Number.isFinite(endTime)) {
        console.error(
          "A curated public event has an invalid end time. Remove or correct the entry in content.ts before the next build."
        );
        item.remove();
      } else if (endTime <= Date.now()) {
        item.remove();
      } else if (nextEndTime === null || endTime < nextEndTime) {
        nextEndTime = endTime;
      }
    }
    return nextEndTime;
  }

  function showCuratedState(): void {
    if (!state || !list) return;
    const hasEvents = list.children.length > 0;
    list.hidden = !hasEvents;
    state.hidden = false;
    state.textContent = hasEvents ? CURATED_STATE : EMPTY_PLACEHOLDER_STATE;
  }

  function refreshCuratedEvents(): void {
    const nextEndTime = pruneExpiredCuratedEvents();
    showCuratedState();
    if (nextEndTime !== null) {
      const delay = Math.min(Math.max(nextEndTime - Date.now() + 1, 1), MAX_TIMEOUT_MS);
      window.setTimeout(refreshCuratedEvents, delay);
    }
  }

  refreshCuratedEvents();
</script>
