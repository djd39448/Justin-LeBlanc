---
/**
 * Renders the focused campaign and navigation destination for event discovery.
 *
 * Dependencies: BaseLayout and EventPlanner.
 * Depended on by: Primary calls to action and campaign URLs.
 * Why this exists: Visitors need a low-distraction route to qualify an inquiry.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import EventPlanner from "../components/EventPlanner.astro";
---

<BaseLayout
  title="Plan Your Event | Justin LeBlanc"
  description="Share your private-event date, city, atmosphere, and known details with Justin LeBlanc."
  canonicalPath="/plan-your-event/"
>
  <section class="page-intro">
    <div class="page-shell">
      <p class="eyebrow">Private-event inquiry</p>
      <h1>Plan Your Event</h1>
      <p>
        It takes three short steps. Mark details as flexible or unknown, review everything, and send
        an inquiry for personal follow-up. A date is not held or confirmed by submitting this form.
      </p>
    </div>
  </section>
  <EventPlanner />
</BaseLayout>
