---
/**
 * Publishes a concise booking and public-links reference.
 *
 * Dependencies: BaseLayout and shared reviewed site content.
 * Depended on by: Footer, sitemap, and agent discovery files.
 * Why this exists: Visitors can understand the path from inquiry to a confirmed performance.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content";
---

<BaseLayout
  title="Booking Reference | Justin LeBlanc"
  description="Booking process and public links for Justin LeBlanc private-event music."
  canonicalPath="/reference/"
>
  <section class="page-intro">
    <div class="page-shell">
      <p class="eyebrow">Private-event music</p>
      <h1>Start with your event.</h1>
      <p>Share the moments you are planning, and we will talk through what fits.</p>
    </div>
  </section>
  <article class="section reading-shell prose">
    <h2>Scope</h2>
    <p>
      Justin LeBlanc's current public website says he is booking private events in Houston and
      beyond. Start by describing your event and requesting a consultation.
    </p>

    <h2>Booking process</h2>
    <ol>
      <li>Share the date or flexible-date choice, city, event type, and desired atmosphere.</li>
      <li>Leave any unknown venue, timing, production, or budget details for follow-up.</li>
      <li>Request a consultation and review any separate tentative event hold.</li>
      <li>A person confirms availability, format, and an agreed quote after consultation.</li>
    </ol>

    <h2>Thoughtful planning</h2>
    <p>
      Your inquiry begins a conversation. Availability, performance format, and the details of your
      event are confirmed personally after we talk.
    </p>

    <h2>Reviewed public sources</h2>
    <ul class="source-list">
      <li><a href={site.currentSite} rel="external">Justin LeBlanc Music</a></li>
      <li><a href={site.instagram} rel="external">Instagram @jus10sense</a></li>
      <li><a href={site.youtube} rel="external">YouTube @jus10sense</a></li>
    </ul>

  </article>
</BaseLayout>
