---
/**
 * Presents Justin and the photographs that anchor the visual identity.
 *
 * Dependencies: BaseLayout and reviewed public links.
 * Depended on by: Footer and reference routes.
 * Why this exists: Visitors can get to know Justin before starting an event inquiry.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ArtistPhotos from "../components/ArtistPhotos.astro";
import { site } from "../content";
---

<BaseLayout title="About Justin LeBlanc" canonicalPath="/about/">
  <section class="page-intro">
    <div class="page-shell">
      <p class="eyebrow">Singer · guitarist · event inquiry</p>
      <h1>Justin LeBlanc, in his own blue.</h1>
      <p>
        A performer who brings a polished, personable presence to the room.
      </p>
    </div>
  </section>
  <ArtistPhotos variant="portrait" />
  <section class="section page-shell split-section">
    <div class="prose">
      <h2>Music for the moments that matter.</h2>
      <p>
        Tell Justin about the people, room, and energy you have in mind. The plan can grow from there.
      </p>
      <p>
        Follow along for music and current updates, or begin planning your own gathering.
      </p>
      <a class="button" href="/#plan-your-event">Tell Justin about your event</a>
    </div>
    <aside class="source-card">
      <p class="eyebrow">Follow Justin</p>
      <h3>Find Justin online.</h3>
      <p>Listen, follow, and keep up with what is next.</p>
      <a class="text-link" href={site.currentSite} rel="external">Current website →</a><br />
      <a class="text-link" href={site.instagram} rel="external">Instagram →</a><br />
      <a class="text-link" href={site.youtube} rel="external">YouTube →</a>
    </aside>
  </section>
</BaseLayout>
