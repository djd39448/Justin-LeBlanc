---
/**
 * Renders the conversion-first private-event landing page.
 *
 * Dependencies: Shared layout, planner, public events, photos, and reviewed FAQ content.
 * Depended on by: The root public route.
 * Why this exists: Visitors can start a thoughtful event inquiry without leaving the opening page.
 */
import ArtistPhotos from "../components/ArtistPhotos.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventPlanner from "../components/EventPlanner.astro";
import FaqList from "../components/FaqList.astro";
import PublicEvents from "../components/PublicEvents.astro";
import { site } from "../content";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.canonicalOrigin,
  image: `${site.canonicalOrigin}/images/justin-blue-guitar-hero.jpg`,
  sameAs: [site.instagram, site.youtube, site.facebook]
};
---

<BaseLayout canonicalPath="/" structuredData={structuredData} preloadHero>
  <section class="opening" aria-labelledby="hero-title">
    <div class="opening__photo" aria-hidden="true"></div>
    <div class="opening__content page-shell">
      <div class="opening__copy">
        <p class="eyebrow">Private-event music</p>
        <h1 id="hero-title">Justin LeBlanc</h1>
        <p>A polished, personable performance shaped around your room, your guests, and the moments they’ll remember.</p>
        <div class="booking-phone">
          <span>Booking inquiries</span>
          <a href={`tel:${site.businessPhone}`} aria-label={`Call Justin LeBlanc at ${site.businessPhoneDisplay}`}>
            {site.businessPhoneDisplay}
          </a>
        </div>
      </div>
      <div id="plan-your-event" class="opening__planner" tabindex="-1">
        <EventPlanner compact />
      </div>
    </div>
  </section>

  <section class="category-rail" aria-label="Events Justin LeBlanc performs for">
    <span>PRIVATE GATHERINGS</span><span>CELEBRATIONS</span><span>CORPORATE RECEPTIONS</span><span>WEDDING INQUIRIES</span>
  </section>

  <PublicEvents />

  <section class="listen section section-blue" id="listen" aria-labelledby="listen-title">
    <div class="page-shell media-stage">
      <div class="media-visual" aria-hidden="true"></div>
      <div class="media-copy">
        <p class="eyebrow">Listen</p>
        <h2 id="listen-title">Music with room to breathe.</h2>
        <p>Listen on Justin’s public channel, then bring the feeling you are after to your event inquiry.</p>
        <a class="button button-light" href={site.youtube} rel="external">Listen on YouTube</a>
      </div>
    </div>
  </section>

  <ArtistPhotos id="follow" showLinks />

  <section class="section section-paper" aria-labelledby="faq-title">
    <div class="page-shell">
      <div class="section-heading">
        <div><p class="eyebrow">A few answers</p><h2 id="faq-title">Let’s make it easy to begin.</h2></div>
        <p>A few things people often want to know before reaching out.</p>
      </div>
      <FaqList />
    </div>
  </section>

  <section class="closing-cta section" aria-labelledby="closing-title">
    <div class="reading-shell">
      <p class="eyebrow">Ready when you are</p>
      <h2 id="closing-title">Tell me about the room.</h2>
      <p>Start with the details you have, and we will take it from there.</p>
      <a class="button" href="#plan-your-event" data-planner-return>PLAN YOUR EVENT</a>
    </div>
  </section>
</BaseLayout>

<script>
  const returnLink = document.querySelector<HTMLAnchorElement>("[data-planner-return]");
  const plannerHeading = document.querySelector<HTMLElement>("#planner-title");
  if (returnLink && plannerHeading) {
    returnLink.addEventListener("click", () => {
      window.setTimeout(() => {
        plannerHeading.setAttribute("tabindex", "-1");
        plannerHeading.focus();
      }, 0);
    });
  }
</script>
