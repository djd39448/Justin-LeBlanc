---
/**
 * Presents honest listening and public-show paths without reproducing unverified listings.
 *
 * Dependencies: BaseLayout and reviewed public source links.
 * Depended on by: Primary navigation and media calls to action.
 * Why this exists: Hearing Justin remains a secondary path into private-event planning.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content";
---

<BaseLayout
  title="Hear Justin | Justin LeBlanc"
  description="Visit Justin LeBlanc's current public music sources and plan a private event."
  canonicalPath="/hear-live/"
>
  <section class="page-intro">
    <div class="page-shell">
      <p class="eyebrow">Listen before you plan</p>
      <h1>Hear Justin from the source.</h1>
      <p>
        The demo links to Justin's public channel and current website. It does not present an
        unapproved clip as a booking sample or copy unverified public-show terms.
      </p>
    </div>
  </section>
  <section class="section page-shell split-section">
    <div>
      <p class="eyebrow">Public music channel</p>
      <h2>YouTube @jus10sense</h2>
      <p>
        The public channel identity matches Justin's linked website profile. Its content spans music
        and personal videos, so choose from the source rather than relying on a curated claim here.
      </p>
      <a class="button" href={site.youtube} rel="external">Open Justin's YouTube</a>
    </div>
    <aside class="source-card">
      <p class="eyebrow">Current public dates</p>
      <h3>Check the live source</h3>
      <p>
        Event listings, venue rules, and admission terms can change. This demo links out until each
        listing is verified; it never labels an event free without venue evidence.
      </p>
      <a class="button button-light" href={`${site.currentSite}events`} rel="external">View current events</a>
    </aside>
  </section>
  <section class="section section-paper">
    <div class="reading-shell prose">
      <h2>Ready to discuss your own event?</h2>
      <p>
        Share the date or flexible-date choice, city, setting, and atmosphere. Specific songs and
        performance format remain part of the conversation.
      </p>
      <a class="button" href="/plan-your-event/">Plan your event</a>
    </div>
  </section>
</BaseLayout>
