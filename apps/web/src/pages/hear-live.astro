---
/**
 * Presents Justin's verified listening channels.
 *
 * Dependencies: BaseLayout and reviewed public source links.
 * Depended on by: Primary navigation and media calls to action.
 * Why this exists: Listening remains a helpful path into private-event planning.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content";
---

<BaseLayout
  title="Listen | Justin LeBlanc"
  description="Listen to Justin LeBlanc and plan a private event."
  canonicalPath="/hear-live/"
>
  <section class="page-intro">
    <div class="page-shell">
      <p class="eyebrow">Listen before you plan</p>
      <h1>Listen to Justin.</h1>
      <p>
        Visit Justin’s public channel for music, then bring the feeling you are after to your event inquiry.
      </p>
    </div>
  </section>
  <section class="section page-shell split-section">
    <div>
      <p class="eyebrow">Public music channel</p>
      <h2>YouTube @jus10sense</h2>
      <p>
        Visit Justin’s public channel to hear more.
      </p>
      <a class="button" href={site.youtube} rel="external">Open Justin's YouTube</a>
    </div>
    <aside class="source-card">
      <p class="eyebrow">Follow along</p>
      <h3>More from Justin.</h3>
      <p>Find current updates and videos through Justin’s public links.</p>
      <a class="button button-light" href={site.instagram} rel="external">Follow on Instagram</a>
    </aside>
  </section>
  <section class="section section-paper">
    <div class="reading-shell prose">
      <h2>Ready to discuss your own event?</h2>
      <p>
        Share the date or flexible-date choice, location, performance time, equipment needs, and
        any special requests you already know.
      </p>
      <a class="button" href="/#plan-your-event">Plan your event</a>
    </div>
  </section>
</BaseLayout>
